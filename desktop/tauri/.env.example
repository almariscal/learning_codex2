# Useful overrides for local development.

# Path or command executed to start the backend when the packaged binary is missing.
# Example (Linux/macOS):
# PARKING_BACKEND_DEV_COMMAND="python3 -m app.desktop.server"
# Example (Windows):
# PARKING_BACKEND_DEV_COMMAND="py -3 -m app.desktop.server"

# Optional path override for the shared data directory.
# PARKING_DATA_DIR="/home/user/.parking-allocator/data"
