{
  "$schema": "https://schema.tauri.app/config.schema.json",
  "package": {
    "productName": "Parking Allocator",
    "version": "0.1.0"
  },
  "build": {
    "beforeDevCommand": "npm --prefix ../../frontend run dev",
    "beforeBuildCommand": "npm --prefix ../../frontend run build",
    "devPath": "http://localhost:5173",
    "distDir": "../../../frontend/dist"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false
      }
    },
    "bundle": {
      "active": true,
      "identifier": "com.parking.allocator",
      "resources": [
        "./backend"
      ],
      "targets": [
        "appimage"
      ],
      "icon": [
        "icons/icon-32x32.png"
      ]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Parking Allocator",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}
